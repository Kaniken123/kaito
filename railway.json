{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "src/**",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      ".dockerignore",
      "railway.json",
      "deploy-commands.js"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 10
  }
}
