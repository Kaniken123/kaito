# ─────────────────────────────────────────────────────────────
# Kaito — environment configuration
# Copy this file to `.env` and fill in the values. See SETUP.md.
# ─────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────
# Bot token from Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Application (client) ID from the app's General Information page
CLIENT_ID=

# ── Discord (optional) ───────────────────────────────────────
# Test server ID. Used by `npm run deploy:commands` for INSTANT command
# registration while developing. Leave blank to register globally (~1h delay).
GUILD_ID=
# Channel where member joins/leaves and moderation actions are logged.
LOG_CHANNEL_ID=

# ── Storage ──────────────────────────────────────────────────
# Path to the SQLite file. On Railway/Fly this must live on a mounted
# volume or it is wiped on every redeploy — see SETUP.md step 8.
DATABASE_PATH=./data/kaito.db

# ── Reddit — powers /cursedfood (optional) ───────────────────
# Without these, /cursedfood falls back to a public proxy (less reliable).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=discord:kaito-cursedfood:v1.0 (by /u/yourname)
# Optional: post a cursed food image to this channel once a day.
CURSED_FOOD_CHANNEL_ID=

# ── LLM — powers ragebait chatbot mode (optional) ────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# Max ragebait replies per guild per UTC day (runaway-spend guard).
RAGEBAIT_DAILY_CAP=200

# ── Misc ─────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
